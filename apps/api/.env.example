# Neon Postgres (from Vercel integration — set same values in Vercel + VPS API env)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional: force SSL on/off (auto-detects localhost vs remote when unset)
# DATABASE_SSL=true

CORS_ORIGINS=http://localhost:3000,https://usersniper.com,https://www.usersniper.com
USER_DATA_DIR=/var/lib/usersniper/data
REDIS_URL=redis://localhost:6379/0
TURBO_WORKERS=160

# Local dev: run turbo in the same process. Production VPS1 control sets SNIPER_DISTRIBUTED=true.
API_MODE=control
SNIPER_DISTRIBUTED=false
