# Copy to apps/web/.env.local for local development

# API proxy target for the Next.js /api/[...path] route (server-side only)
# Local: http://localhost:8000
# Production (Vercel): http://31.97.179.26  (HTTP only — TLS on api.usersniper.com:443 is broken)
API_PROXY_URL=http://localhost:8000

# Optional: override API base for client-side direct calls (usually leave unset — same-origin /api)
# NEXT_PUBLIC_API_URL=
